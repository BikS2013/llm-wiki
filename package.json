{
  "name": "llm-wiki",
  "version": "0.1.0",
  "description": "TypeScript implementation of Andrej Karpathy's LLM Wiki pattern: an LLM-maintained, interlinked markdown wiki compiled from raw sources, with local BM25/vector search, ingest, query, lint, and an MCP server.",
  "type": "module",
  "bin": {
    "llm-wiki": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.4.6",
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "mammoth": "^1.12.3",
    "openai": "^7.15.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
